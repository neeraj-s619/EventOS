# EVENTOS Backend Environment Variables
# Copy this file to .env and configure with your specific values

APP_NAME=EVENTOS
APP_VERSION=0.2.0
DEBUG=true

# Database (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./eventos.db

# ==============================================================================
# META WHATSAPP CLOUD API CONFIGURATION
# ==============================================================================
# Operational mode: 'cloud' (real Meta Cloud API), 'sandbox' (local testing), 'disabled'
WHATSAPP_ENABLED=false
WHATSAPP_MODE=sandbox

# Meta Graph API Base & Version
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0

# Meta Developer Credentials (From Meta App Dashboard -> WhatsApp -> API Setup)
# NEVER commit real tokens to git or expose in frontend
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_or_temporary_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_whatsapp_business_account_id_here

# Webhook Handshake & Security
# Set this exact token in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook -> Edit
WHATSAPP_VERIFY_TOKEN=your_secure_random_verification_token_here
# App Secret (From App Dashboard -> App Settings -> Basic -> App Secret)
# Used for HMAC-SHA256 signature validation (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Webhook Path on EVENTOS backend
WHATSAPP_WEBHOOK_PATH=/api/v1/whatsapp/webhook

# Operational Confirmation Flow:
# false: Two-step confirmation (Provider sends capacity -> EVENTOS sends CONFIRM request -> Provider confirms -> DB updated)
# true: Auto-confirm (Parses, validates, and immediately updates DB)
WHATSAPP_AUTO_CONFIRM=false

# ==============================================================================
# TELEGRAM OPERATIONS NETWORK CONFIGURATION (TWO BOTS)
# ==============================================================================
# Bot 1: Visitor Bot Token from @BotFather (e.g. for @eventos_visitor_bot)
TELEGRAM_VISITOR_BOT_TOKEN=
TELEGRAM_VISITOR_BOT_USERNAME=eventos_visitor_bot

# Bot 2: Staff / Ops Bot Token from @BotFather (e.g. for @eventos_ops_bot or @hckathn_bot)
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_STAFF_BOT_USERNAME=hckathn_bot

# Legacy fallback token (optional)
TELEGRAM_BOT_TOKEN=

# Operational Mode: 'polling' (local development via getUpdates) or 'webhook' (production HTTPS)
TELEGRAM_MODE=polling

# Production Webhook Configuration (Optional - only needed if TELEGRAM_MODE=webhook)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Polling Interval (seconds) for local polling worker
TELEGRAM_POLL_INTERVAL=2.0

# Simulation Settings
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_SECONDS=30

# ==============================================================================
# NUGEN INTELLIGENCE (HACKCELESTIAL 3.0 TASK 2 - DOMAIN ALIGNED AI)
# ==============================================================================
# Nugen API Key from https://nugen.in developer portal
# NEVER commit real tokens to git or expose in frontend
NUGEN_API_KEY=
NUGEN_MODEL_ID=nugen-aligned-eventos-v1
NUGEN_BASE_MODEL=nugen-base-v1
NUGEN_API_URL=https://api.nugen.in
NUGEN_ENABLED=true
NUGEN_MODE=auto


